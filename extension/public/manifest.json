{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Applywise — Job Application Copilot",
  "version": "1.0.0",
  "description": "Use your profile and AI to draft job application answers and fill forms you review.",
  "action": {
    "default_title": "Open Applywise"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
